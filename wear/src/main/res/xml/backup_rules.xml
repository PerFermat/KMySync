<?xml version="1.0" encoding="utf-8"?>
<!--
    Das Gegenstück zu data_extraction_rules.xml für Android 8 bis 11, wo es die getrennten Abschnitte
    für Cloud und Geräteübertragung noch nicht gibt.

    Wirkung hat die Datei derzeit nicht: android:allowBackup="false" schaltet die Sicherung auf diesen
    Ständen ohnehin vollständig ab. Sie steht hier, weil die Absicht für jeden Stand ausdrücklich
    festgehalten sein soll – und weil ein späteres Einschalten von allowBackup sonst schlagartig alles
    mitnähme. Lint verlangt sie aus demselben Grund (DataExtractionRules).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
