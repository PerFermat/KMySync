<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:boxedEdges="all">

        <!-- Zustand A: Typ wählen -->
        <LinearLayout
            android:id="@+id/typeSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <!-- Grauer Wechsel-Knopf: Konto/Ort durchschalten (oberhalb von „Buchung erfassen", mittig). -->
            <ImageButton
                android:id="@+id/btnCycle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#757575"
                android:contentDescription="@string/wear_switch"
                android:scaleType="center"
                android:src="@drawable/ic_cycle"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wear_title"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnIncome"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/type_income"
                        android:contentDescription="@string/wear_type_income"
                        android:scaleType="center"
                        android:src="@drawable/ic_plus" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnTransfer"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/type_transfer"
                        android:contentDescription="@string/wear_type_transfer"
                        android:scaleType="center"
                        android:src="@drawable/ic_swap" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnExpense"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/type_expense"
                        android:contentDescription="@string/wear_type_expense"
                        android:scaleType="center"
                        android:src="@drawable/ic_minus" />
                </LinearLayout>
            </LinearLayout>

            <!-- Einzige Zeile auf dem Rundschirm: Konto/Ort-Saldo vom Phone (z. B. „Geldbeutel: 70,00 €")
                 ODER – falls vorhanden – eine Meldung (Übertragungs-Hinweis bzw. einmalige Meldung), die
                 den Saldo ersetzt. Es gibt bewusst keine zweite Zeile. Schriftgröße wie im Tile (12sp). -->
            <TextView
                android:id="@+id/balanceView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Zustand B: erkannter Text + Abbrechen (10 s) -->
        <LinearLayout
            android:id="@+id/confirmView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/confirmType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confirmText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wear_cancel" />

            <!-- Nur im „Sprich jetzt"-Zustand: stille Zifferneingabe öffnen. -->
            <ImageButton
                android:id="@+id/btnNumberPad"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#455A64"
                android:contentDescription="@string/wear_number_entry"
                android:scaleType="center"
                android:src="@drawable/ic_dialpad"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

    <!--
        Zustand D: Bestätigung der Zifferneingabe (Betrag, Empfänger, Countdown). Ebenfalls neben dem
        eingerückten Rahmen, weil die Farbe der Buchungsart die ganze runde Fläche tragen soll – im
        Einzug bliebe ein Quadrat auf schwarzem Grund stehen. Der Inhalt hält über die Innenabstände
        Abstand vom Rand; unten mehr, sonst stößt der Abbrechen-Knopf an die Rundung.
    -->
    <LinearLayout
        android:id="@+id/numberConfirmView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="34dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/confirmAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--
            Empfänger im 100-m-Umkreis: immer nur einer. Der graue Knopf darunter schaltet zum
            nächsten und nach dem letzten auf „ohne Empfänger" – dieselbe Runde wie in der
            Ziffernmaske am Handy. Liegt keiner so nah, bleiben Zeile und Knopf weg.
        -->
        <TextView
            android:id="@+id/payeeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnPayeeNext"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#757575"
            android:contentDescription="@string/wear_payee_next"
            android:scaleType="center"
            android:src="@drawable/ic_cycle"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/wear_cancel" />
    </LinearLayout>

    <!--
        Zustand C: stille Zifferneingabe (Zahlenblock). Bewusst NEBEN dem eingerückten Rahmen und
        damit über die volle Fläche: Im runden Einzug bleiben nur rund 160 dp, dort ließen sich vier
        Tastenreihen nur mit Scrollen oder mit Tasten unterbringen, die kein Finger mehr trifft. Die
        äußersten Ecken der Ecktasten liegen dafür knapp am Rand – die Flächen bleiben treffbar.
    -->
    <LinearLayout
        android:id="@+id/numberView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!--
            Die Reihen folgen der Rundung: Oben und unten ist der Bildschirm schmal, deshalb rücken
            die erste und die letzte Reihe weit ein, die mittleren kaum. Mit einem gleichmäßigen
            Raster wären die Ecktasten vom Rand angeschnitten. Höhen: 28 + 4×40 = 188 dp von 228 dp,
            damit paßt alles ohne Scrollen auf den Schirm.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="50dp">

            <TextView
                android:id="@+id/numberDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Weiter zur Bestätigung; steht neben dem Betrag, damit unten die vierte Tastenreihe
                 Platz hat. -->
            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="34dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/type_income"
                android:contentDescription="@string/wear_number_entry"
                android:scaleType="center"
                android:src="@drawable/ic_check" />
        </LinearLayout>

        <LinearLayout style="@style/WearKeyRow" android:paddingHorizontal="30dp">
            <Button android:id="@+id/btnD1" style="@style/WearKey" android:text="1" />
            <Button android:id="@+id/btnD2" style="@style/WearKey" android:text="2" />
            <Button android:id="@+id/btnD3" style="@style/WearKey" android:text="3" />
        </LinearLayout>

        <LinearLayout style="@style/WearKeyRow" android:paddingHorizontal="8dp">
            <Button android:id="@+id/btnD4" style="@style/WearKey" android:text="4" />
            <Button android:id="@+id/btnD5" style="@style/WearKey" android:text="5" />
            <Button android:id="@+id/btnD6" style="@style/WearKey" android:text="6" />
        </LinearLayout>

        <LinearLayout style="@style/WearKeyRow" android:paddingHorizontal="14dp">
            <Button android:id="@+id/btnD7" style="@style/WearKey" android:text="7" />
            <Button android:id="@+id/btnD8" style="@style/WearKey" android:text="8" />
            <Button android:id="@+id/btnD9" style="@style/WearKey" android:text="9" />
        </LinearLayout>

        <LinearLayout style="@style/WearKeyRow" android:paddingHorizontal="50dp">
            <Button android:id="@+id/btnComma" style="@style/WearKey" android:text="," />
            <Button android:id="@+id/btnD0" style="@style/WearKey" android:text="0" />
            <Button android:id="@+id/btnBack" style="@style/WearKey" android:text="⌫" />
        </LinearLayout>
    </LinearLayout>
</androidx.wear.widget.BoxInsetLayout>
