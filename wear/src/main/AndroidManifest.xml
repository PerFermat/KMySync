<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Für die programmatische Spracherkennung (kein manuelles Bestätigen). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Für die GPS-Koordinaten, die zum Sprechzeitpunkt bestimmt und mitübertragen werden. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Um zu erkennen, ob gerade echtes Internet da ist (dann Online-Erkennung, sonst Offline bevorzugen). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ein kurzer Stoß, sobald der Erkennungsdienst wirklich aufnimmt: unterwegs ist das Handgelenk
         das verlässlichere Startzeichen als ein Blick aufs Display. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!--
        Keine Systemsicherung – wie in der Phone-App, und hier erst recht: Die Uhr hält nur
        Zwischenstände offline erfasster Buchungen, die ohnehin ans Handy wandern. Gesichert wird
        über «Sicherung erstellen» in der Phone-App.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AusgabenWear">

        <!-- Benötigt die Phone-App (keine eigenständige Wear-App). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reagiert auf verarbeitete Buchungen (DataItem-Löschung), Sprach-Aktualisierung und
             synchronisiert bei Wiederverbindung automatisch. -->
        <service
            android:name=".WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/expense" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/language" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/balance" />
                <!-- Ohne diese Zeile stellt das System den Pfad gar nicht zu: Das Handy sendet, der
                     Listener schweigt, und man sucht den Fehler auf der falschen Seite. -->
                <data android:scheme="wear" android:host="*" android:pathPrefix="/payees" />
            </intent-filter>
        </service>

        <!-- Wear-Tile („Widget"): öffnet die App und startet die Spracheingabe. -->
        <service
            android:name=".ExpenseTileService"
            android:exported="true"
            android:label="@string/wear_title"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- Ohne das zeigt die Auswahlliste der Uhr nur das App-Symbol; im Log steht dann
                 «DefaultMetadataPreviewProvider: Service … has no metadata». -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

    </application>

</manifest>
