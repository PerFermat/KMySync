<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Für die optionalen GPS-Koordinaten in der Notiz (nur lokal, kein externer Dienst). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- osmdroid empfiehlt Netzwerkstatus für das Nachladen der Kartenkacheln. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nur für die (standardmäßig ausgeschaltete) Erinnerung an fällige geplante Buchungen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Keine Systemsicherung. Buchungen, Belegfotos und der Serverzugang verlassen dieses Gerät nur
        dorthin, wohin der Nutzer sie selbst schickt; ohne Regeln nähme eine Systemsicherung die
        Datenbank und den Belegordner mit. Wer sichern will, nimmt «Sicherung erstellen» in den
        Einstellungen – verschlüsselt und mit der Wahl, ob das Server-Passwort überhaupt mitgeht.

        Dazu ein technischer Grund: Die verschlüsselte Prefs-Datei würde mitgesichert, ihr Schlüssel
        im Android-Keystore aber nicht. Nach dem Einspielen auf einem anderen Gerät läge eine Datei
        vor, die zu keinem Schlüssel mehr passt (siehe SettingsStore.createSecretPrefs).

        allowBackup deckt die Cloud-Sicherung ab, dataExtractionRules zusätzlich die
        Geräteübertragung ab Android 12 – die hängt nicht an allowBackup. fullBackupContent ist das
        Gegenstück für Android 8 bis 11; wirkungslos, solange allowBackup aus ist, aber es hält die
        Absicht für jeden Stand fest.
    -->
    <application
        android:name=".AusgabenApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ausgaben">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Langdruck auf das App-Symbol → „Neue Ausgabe". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ProfileSettingsActivity"
            android:exported="false"
            android:label="@string/settings_profile_change"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.BookingEditActivity"
            android:exported="false"
            android:label="@string/edit_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AccountManageActivity"
            android:exported="false"
            android:label="@string/accounts_manage_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AliasActivity"
            android:exported="false"
            android:label="@string/alias_manage_title"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.AliasEditActivity"
            android:exported="false"
            android:label="@string/alias_edit_title"
            android:parentActivityName=".ui.AliasActivity" />

        <activity
            android:name=".ui.MapPickerActivity"
            android:exported="false"
            android:label="@string/map_pick_title"
            android:parentActivityName=".ui.AliasEditActivity" />

        <activity
            android:name=".ui.AnalysisActivity"
            android:exported="false"
            android:label="@string/analysis_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.BalanceActivity"
            android:exported="false"
            android:label="@string/balance_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.CategoryChartActivity"
            android:exported="false"
            android:label="@string/category_chart_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.CategoryColorActivity"
            android:exported="false"
            android:label="@string/category_colors_title"
            android:parentActivityName=".ui.CategoryChartActivity" />

        <activity
            android:name=".ui.BudgetActivity"
            android:exported="false"
            android:label="@string/budget_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ScheduledActivity"
            android:exported="false"
            android:label="@string/scheduled_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ScheduledChartActivity"
            android:exported="false"
            android:label="@string/scheduled_title"
            android:parentActivityName=".ui.ScheduledActivity" />

        <!-- Kein parentActivityName: das Depot ist keine Unteransicht der Kontoansicht,
             sondern eine gleichrangige Auswahl aus der Kontenschublade. -->
        <activity
            android:name=".ui.DepotActivity"
            android:exported="false"
            android:label="@string/depot_title" />

        <activity
            android:name=".ui.SecurityHistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.DepotActivity" />

        <activity
            android:name=".ui.StatementRulesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.DepotActivity" />

        <activity
            android:name=".ui.StatementBatchActivity"
            android:exported="false"
            android:parentActivityName=".ui.DepotActivity" />

        <activity
            android:name=".ui.SecurityTxEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.SecurityHistoryActivity" />

        <activity
            android:name=".ui.DepotChartActivity"
            android:exported="false"
            android:parentActivityName=".ui.DepotActivity" />

        <activity
            android:name=".ui.PlaceHistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.BalanceActivity" />

        <activity
            android:name=".ui.ReceiptEditActivity"
            android:exported="false"
            android:label="@string/receipt_edit_title"
            android:parentActivityName=".ui.BookingEditActivity" />

        <activity
            android:name=".ui.ReceiptViewActivity"
            android:exported="false"
            android:label="@string/receipt_view_title"
            android:parentActivityName=".ui.BookingEditActivity" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:theme="@style/Theme.Ausgaben" />

        <!-- Unsichtbare Sprach-Schnellerfassung aus dem Typ-Widget (kein sichtbares App-UI). -->
        <activity
            android:name=".ui.VoiceCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ausgaben.Transparent" />

        <!-- Tageswecker der Erinnerung an fällige geplante Buchungen; BOOT_COMPLETED stellt ihn nach
             einem Neustart neu (Wecker überleben den Neustart nicht). -->
        <receiver
            android:name=".notify.ScheduledReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Homescreen-Widgets (drei Größen: klein/mittel/groß). -->
        <receiver
            android:name=".widget.WidgetSmall"
            android:exported="true"
            android:label="@string/widget_small_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetMedium"
            android:exported="true"
            android:label="@string/widget_medium_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetLarge"
            android:exported="true"
            android:label="@string/widget_large_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetType"
            android:exported="true"
            android:label="@string/widget_type_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_type_info" />
        </receiver>

        <!-- Belegfotos: FileProvider, um app-private Bilder an die Kamera-App und den System-Bildbetrachter
             zu übergeben (content://…). Keine CAMERA-/Storage-Berechtigung nötig. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Der Wear-Data-Layer-Listener (Google Play Services) wird nur im „full"-Flavor registriert:
             siehe app/src/full/AndroidManifest.xml. Der „foss"-Flavor (F-Droid) enthält kein GMS. -->

    </application>

</manifest>
