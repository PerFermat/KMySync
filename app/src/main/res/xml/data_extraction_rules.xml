<?xml version="1.0" encoding="utf-8"?>
<!--
    Ab Android 12 steuert diese Datei, was das System mitnimmt. Sie ist nicht nur die Ergänzung zu
    android:allowBackup="false", sondern deckt den Fall ab, den jenes Attribut offenlässt: die
    Geräteübertragung beim Umzug auf ein neues Gerät.

    Ausgeschlossen wird alles – Datenbank, Belegordner, Einstellungen, verschlüsselte wie
    unverschlüsselte. Die Begründung steht im Manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
