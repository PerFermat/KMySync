<?xml version="1.0" encoding="utf-8"?>
<!-- Schlüssel bzw. Passwort für eine verschlüsselte KMyMoney-Datei: GPG bei der .kmy, SQLCipher bei der
     Datenbank. Steht im Willkommen-Assistenten und in den Profileinstellungen unter dem Pfad; welche
     Hälfte sichtbar ist, richtet sich nach dem Format (siehe EncryptionFields). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Nur nötig, wenn KMyMoney die .kmy mit GPG verschlüsselt (GpgKeysController). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGpgKeys"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/gpg_button" />

    <TextView
        android:id="@+id/gpgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Nur bei einer Datenbank, die KMyMoney mit SQLCipher verschlüsselt (DbPasswordController). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDbPassword"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/db_password_button" />

    <TextView
        android:id="@+id/dbPasswordStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
