<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout als Wurzel, damit die Rechentastatur im Querformat ueber dem Formular
     schweben kann: dort ist sie ein Quadrat in der Mitte, und links und rechts davon
     bleibt das Formular sichtbar und scrollbar. Im Hochformat haelt der Platzhalter
     calcSpacer ihre Hoehe frei, dann steht sie wie bisher unter dem Formular. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green_primary"
            android:theme="@style/ThemeOverlay.Ausgaben.Toolbar"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/security_tx_new_title"
            app:titleTextColor="@color/white" />

        <!-- Statuszeile beim Nachladen der Abrechnung (unbestimmt, ohne Prozent) – wie im Konto. -->
        <FrameLayout
            android:id="@+id/receiptBanner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:visibility="gone">

            <de.spahr.ausgaben.ui.ShimmerView
                android:id="@+id/receiptShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/receiptStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:textStyle="bold"
                android:textColor="@color/import_banner_text"
                android:text="@string/receipt_loading_wait" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_buy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSell"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_sell" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDividend"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_dividend" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Kam die Maske aus einer Abrechnung, in der die Art nicht zu erkennen war: dann ist kein
                     Knopf vorgewählt, und hier steht, warum. -->
                <TextView
                    android:id="@+id/actionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/statement_action_missing"
                    android:textColor="@color/expense_red"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Dieselbe Buchung scheint es schon zu geben. Steht bewusst hier oben, gleich nach der
                     Auswahl der Art: dort fängt der Blick an, und der Hinweis kommt nicht erst beim
                     Speichern. Er hält nichts auf – gebucht werden darf trotzdem. -->
                <TextView
                    android:id="@+id/duplicateWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/statement_warn_bg"
                    android:padding="8dp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Nur in der reinen Ansicht: farbige Überschrift statt der Umschaltknöpfe. -->
                <TextView
                    android:id="@+id/actionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconContentDescription="@string/date_pick"
                    android:hint="@string/date_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/sharesRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/sharesLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/security_tx_shares">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editShares"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/priceLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/security_tx_price">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Nur bei einer Dividende: der Bruttobetrag ist dort ein eigenes Eingabefeld. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/grossLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:hint="@string/security_tx_gross">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editGross"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/feeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/security_tx_fee">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/netLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/security_tx_total">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editNet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/accountLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/security_tx_account">

                    <de.spahr.ausgaben.ui.PickerTextView
                        android:id="@+id/editAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:paddingVertical="14dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="18sp"
                        android:completionThreshold="1"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Erscheint nur, solange eine passende geplante Umbuchung erkannt ist (siehe
                     ScheduleMatch); vorbelegt angehakt, aktives Abwählen unterdrückt die Zuordnung. -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbScheduleMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="true"
                    android:visibility="gone" />

                <!-- Nur bei einer Dividende: der Bruttobetrag hängt in KMyMoney an Ertragskategorien.
                     Mehrere sind erlaubt, wie bei einer Splitbuchung; die Zeilen kommen aus
                     item_split_row.xml und werden vom SplitRowController verwaltet. -->
                <LinearLayout
                    android:id="@+id/incomeSplitBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/incomeSplitHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_tx_income_category"
                        android:textColor="@color/green_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/incomeSplitContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Steuern und Gebühren, ebenso aufteilbar: Kapitalertragsteuer, Solidaritäts-
                     zuschlag und Kirchensteuer sind drei Kategorien, nicht eine. -->
                <LinearLayout
                    android:id="@+id/feeSplitBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/feeSplitHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_tx_fee_category"
                        android:textColor="@color/green_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/feeSplitContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!--
                    Notiz und Beleg der gespeicherten Bewegung – nur zum Ansehen. Geändert wird beides
                    auf dem Verrechnungskonto, dort hängt die Buchung mit dem Belegwerkzeug.
                -->
                <TextView
                    android:id="@+id/textNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Belegzeile wie im Konto: Beschriftung links, je Seite ein Symbol rechts. -->
                <LinearLayout
                    android:id="@+id/rowReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textReceipt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/receiptPageIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/security_tx_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/security_tx_delete"
                    app:strokeColor="@color/expense_red"
                    android:textColor="@color/expense_red"
                    android:visibility="gone" />

                <!-- Nur in der reinen Ansicht: was die Bewegung sonst noch hergibt (Gebühr, Steuer, Belastung). -->
                <LinearLayout
                    android:id="@+id/detailBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Haelt im Hochformat die Hoehe der Tastatur frei, damit nichts hinter ihr
             verschwindet; quer bleibt er verborgen. Gesteuert von der Tastatur selbst. -->
        <Space
            android:id="@+id/calcSpacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Eigene Rechentastatur; nur sichtbar, wenn das Betragsfeld aktiv ist. -->
    <de.spahr.ausgaben.ui.CalcKeyboardView
        android:id="@+id/calcKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingHorizontal="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />
</FrameLayout>
