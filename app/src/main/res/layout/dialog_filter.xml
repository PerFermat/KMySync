<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <!-- Sucht in Empfänger, Notiz und Kategorie als reine Freitextsuche (kein Auswahlfeld).

             Die Lupe auf der Tastatur übernimmt den Filter unmittelbar (siehe Keyboard.onCommitAction):
             „Übernehmen" sitzt am Ende dieses langen Dialogs und damit unter der Tastatur, die beim
             Antippen dieses Feldes hochfährt. maxLines="1" gehört dazu – ohne das bliebe die
             Eingabetaste ein Zeilenumbruch und imeOptions wirkungslos. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/filter_search_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/filterPayee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="18sp"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/category_filter_hint">

            <de.spahr.ausgaben.ui.PickerTextView
                android:id="@+id/filterCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="18sp"
                android:completionThreshold="1"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bleibt unsichtbar, solange die App keine Stichwörter aus einer .kmy kennt. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/filterTagLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/tags_filter_hint"
            android:visibility="gone">

            <de.spahr.ausgaben.ui.PickerTextView
                android:id="@+id/filterTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="18sp"
                android:completionThreshold="1"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/amount_hint"
            android:textColor="@color/grey_text" />

        <de.spahr.ausgaben.ui.ZeroMarkSlider
            android:id="@+id/filterAmountSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="@string/amount_from">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filterAmountFrom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="@string/amount_to">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filterAmountTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/filter_date_range"
            android:textColor="@color/grey_text" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/filterDateSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="@string/filter_date_from">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filterDateFrom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="@string/filter_date_to">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filterDateTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Umkreis um die eigene Position; nur sichtbar, wenn der Standort eingeschaltet ist.
             Jeder Tipp schaltet eine Stufe weiter (siehe RadiusFilter). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterRadius"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/filter_radius_off" />

    </LinearLayout>
</ScrollView>
