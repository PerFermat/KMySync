<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Akzent-Textfarbe für Outlined-/Dialog-Buttons: weiß im Dunkelmodus (sonst unlesbar).
         Bewusst #FFFFFE statt #FFFFFFFF: AccentColor.retint() erkennt akzentgefärbten Text am exakten
         Farbwert. Mit reinem Weiß wäre das nicht mehr von gewöhnlichem weißem Kontrast-Text auf grünem
         Grund (z. B. Kontoname im Schubladenkopf) zu unterscheiden – der würde dann fälschlich auf die
         Akzentfarbe umgefärbt und verschwindet, wenn diese mit dem Hintergrund übereinstimmt. Der
         Unterschied ist für das Auge nicht wahrnehmbar. -->
    <color name="button_accent">#FFFFFFFE</color>
    <!-- Etwas hellere Signalfarben für besseren Kontrast auf dunklem Grund -->
    <color name="income_green">#81C784</color>
    <color name="expense_red">#EF9A9A</color>
    <!-- Diagramm-Text (Werte/Achsen): weiß im Dunkelmodus -->
    <color name="chart_text">#FFFFFF</color>
    <color name="chart_line">#64B5F6</color>
    <color name="saldo_bar_bg">#3A3A3A</color>
    <color name="saldo_bar_flash">#565656</color>
    <color name="list_divider">#333333</color>
    <!-- Geschlossene Konten: auf dunklem Grund ist der Abstand zur weißen Schrift so schon richtig. -->
    <color name="closed_account_text">#757575</color>
    <!-- Homescreen-Widget (Nacht) -->
    <color name="widget_bg">#1E1E1E</color>
    <color name="widget_text">#FFFFFF</color>
    <color name="widget_text_secondary">#B0B0B0</color>
    <!-- Import-Banner: dunkelgelb mit weißer Schrift (Dunkel-Modus) -->
    <color name="import_banner_bg">#F57F17</color>
    <color name="import_banner_text">#FFFFFF</color>
    <!-- Wandernder Verlauf im Import-Banner (etwas helleres Amber) -->
    <color name="import_banner_shimmer">#FFB300</color>
    <!-- Haken und Kreuz im Band. Der Grund bleibt auch nachts ein Amber (#F57F17) und damit hell –
         deshalb hier keine aufgehellten Töne wie bei income_green/expense_red, sondern kräftige
         dunkle, die darauf stehen. Nur eine Spur satter als im Hell-Modus. -->
    <color name="diag_ok">#134016</color>
    <color name="diag_fail">#7F0000</color>
    <!-- Erkennungsliste: dasselbe Signal, aber dunkel genug für weiße Schrift. -->
    <color name="statement_error_bg">#5D2C2C</color>
    <!-- Der Doppelungs-Hinweis, ebenfalls dunkel genug für weiße Schrift. -->
    <color name="statement_warn_bg">#5A4B1F</color>
</resources>
