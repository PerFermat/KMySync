<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="green_primary">#1B5E20</color>
    <color name="green_dark">#0F3D14</color>
    <color name="green_accent">#43A047</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="expense_red">#C62828</color>
    <color name="income_green">#2E7D32</color>
    <!-- Umbuchung: kräftiges Gelb/Amber (auf hell und dunkel lesbar) -->
    <color name="transfer_yellow">#F9A825</color>
    <!-- Homescreen-Widget (Tag) -->
    <color name="widget_bg">#FFFFFF</color>
    <color name="widget_text">#1B1B1B</color>
    <color name="widget_text_secondary">#6B6B6B</color>
    <color name="grey_text">#757575</color>
    <!-- Untertitel der Toolbar (z. B. „Filter aktiv"): helles Grau auf dem grünen Band – lesbar,
         aber vom weißen Titel abgesetzt. Ohne diese Angabe bliebe der Untertitel schwarz. -->
    <color name="toolbar_subtitle">#CCFFFFFF</color>
    <!-- Geschlossene Konten in der Kontenverwaltung: heller als der übrige graue Text, damit sie
         deutlich zurücktreten. Im Dunkelmodus bleibt es beim kräftigeren Grau (siehe values-night). -->
    <color name="closed_account_text">#A6A6A6</color>
    <!-- Akzent-Textfarbe für Outlined-/Dialog-Buttons: grün im Hell-Modus -->
    <color name="button_accent">#1B5E20</color>
    <!-- Füllung der bestätigenden Taste in zerstörenden Abfragen. Eigener Name, weil expense_red
         im Dunkelmodus zu einem hellen Rosa wird – als Textfarbe richtig, als Füllung unter weißer
         Schrift unlesbar. Dieser Ton trägt Weiß in beiden Modi. -->
    <color name="danger_button">#C62828</color>
    <!-- Diagramm-Text (Werte/Achsen): schwarz im Hell-Modus -->
    <color name="chart_text">#000000</color>
    <!-- Diagramm-Linie (laufender Saldo) -->
    <color name="chart_line">#1565C0</color>
    <!-- Saldo-Leiste: dauerhaft grau, beim Wechsel kurz heller -->
    <color name="saldo_bar_bg">#ECECEC</color>
    <color name="saldo_bar_flash">#F5F5F5</color>
    <!-- Trennlinie zwischen Buchungszeilen (kMyMoney-Ledger-Optik) -->
    <color name="list_divider">#EEEEEE</color>
    <!-- Import-Banner: hellgelb mit schwarzer Schrift (Hell-Modus) -->
    <color name="import_banner_bg">#FFF59D</color>
    <color name="import_banner_text">#000000</color>
    <!-- Wandernder Verlauf im Import-Banner (etwas kräftigeres Gelb) -->
    <color name="import_banner_shimmer">#FFEB3B</color>
    <!-- Haken und Kreuz im Band während „Verbindung testen". Eigene Namen statt income_green und
         expense_red: die stehen für Einnahmen und Ausgaben, und eine Änderung dort soll nicht
         ungewollt hier landen. Beide Töne müssen auf dem gelben Grund des Bandes lesbar sein. -->
    <color name="diag_ok">#1B5E20</color>
    <color name="diag_fail">#B71C1C</color>
    <!-- Zeile der Erkennungsliste, die noch nicht buchbar ist: gedecktes Rot, auf dem die dunkle
         Schrift der Liste lesbar bleibt (siehe values-night für den Gegenpart). -->
    <color name="statement_error_bg">#FFCDD2</color>
    <!-- Zeile der Erkennungsliste, die buchbar ist, aber doppelt zu sein scheint: gedecktes Gelb. -->
    <color name="statement_warn_bg">#FFF9C4</color>
</resources>
