<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Ausgaben" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="toolbarStyle">@style/Widget.Ausgaben.Toolbar</item>
    </style>

    <!-- Unsichtbare Aktivität für die Sprach-Schnellerfassung aus dem Widget (nur der System-Sprachdialog
         erscheint über dem Homescreen; die App selbst wird nicht sichtbar geöffnet). -->
    <style name="Theme.Ausgaben.Transparent" parent="Theme.Ausgaben">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Toolbar-Icons (Aktionen + Überlauf-Punkte) immer weiß auf grünem Grund. -->
    <style name="ThemeOverlay.Ausgaben.Toolbar" parent="">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!--
        Hier stand einmal, das Überlauf-Menü nutze weiter das App-Theme. Das stimmte nicht: Ohne
        eigenes popupTheme nimmt das Menü den Theme-Kontext der Toolbar – also das Weiß von oben.
        Alles darin war damit weiß auf hellem Grund.

        Es braucht BEIDE Hälften, sie greifen an verschiedenen Zeitpunkten:

        • Der Aufklapp-Pfeil bei „Berichte" und alles andere, was der Aufklapper selbst zeichnet,
          hängt am popupTheme – das hier.
        • Die Symbole der Einträge nicht: Ihr {@code ?attr/colorControlNormal} ist längst aufgelöst,
          wenn das Menü aufgeblasen wird. Sie werden in {@link MenuIcons} nachträglich umgefärbt.

        Gesetzt wird das nicht in 25 Layouts, sondern einmal über den Toolbar-Standardstil des
        App-Themes. Der Elternstil ist genau der, den Material3 ohnehin verwendet – es kommt nur
        popupTheme hinzu, am Aussehen der Leisten ändert sich nichts.
    -->
    <style name="Widget.Ausgaben.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="popupTheme">@style/ThemeOverlay.Ausgaben.Popup</item>
    </style>

    <style name="ThemeOverlay.Ausgaben.Popup" parent="">
        <item name="colorControlNormal">@color/menu_icon</item>
    </style>

    <!-- Bestätigungs-/Filter-Dialoge: Button-Text grün (hell) / weiß (dunkel) -->
    <style name="ThemeOverlay.Ausgaben.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/button_accent</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Ausgaben</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Ausgaben.BodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Ausgaben.DialogButton.Confirm</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Ausgaben.DialogButton.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Ausgaben.DialogButton.Text</item>
    </style>

    <!-- Zerstörende Abfragen (löschen, zurücksetzen): dieselbe Form, aber die bestätigende Taste rot.
         Wird über AppDialog.destructive(…) gewählt. -->
    <style name="ThemeOverlay.Ausgaben.Dialog.Destructive" parent="ThemeOverlay.Ausgaben.Dialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Ausgaben.DialogButton.Danger</item>
    </style>

    <!-- Gemeinsame Form aller Pop-ups: 16dp. Dieselbe Rundung trägt popup_background.xml für die
         Vorschlagslisten der Eingabefelder, damit Dialog und Liste wie aus einem Guss wirken. -->
    <style name="ShapeAppearance.Ausgaben.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Der Text rückt vom Band ab: dessen Innenabstand liegt jetzt im Grünen und trennt deshalb nicht. -->
    <style name="MaterialAlertDialog.Ausgaben.BodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:paddingTop">16dp</item>
    </style>

    <style name="MaterialAlertDialog.Ausgaben" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Ausgaben.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <!-- Der Hauptweg ist gefüllt, alles daneben bleibt Text: so ist in einem Blick zu sehen, was die
         Abfrage von einem will. Knapper als die Material-Vorgabe (24dp, Mindestbreite 58dp), damit
         auch drei Tasten nebeneinander passen. -->
    <style name="Widget.Ausgaben.DialogButton.Confirm" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Widget.Ausgaben.DialogButton.Danger" parent="Widget.Ausgaben.DialogButton.Confirm">
        <item name="backgroundTint">@color/danger_button</item>
    </style>

    <style name="Widget.Ausgaben.DialogButton.Text" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/button_accent</item>
    </style>

    <!-- Tasten der eigenen Rechentastatur (CalcKeyboardView). -->
    <style name="CalcKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@animator/calc_key_press</item>
    </style>

    <!-- Operator-/Löschtasten (⌫ * +): abgesetzt in Grün. -->
    <style name="CalcKey.Action" parent="CalcKey">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Querformat: sechs senkrechte Spalten. Die Höhe kommt aus dem Gewicht, nicht aus einem festen
         dp-Wert – so füllen drei Reihen den Rahmen genau aus, den CalcKeyboardView vorgibt. -->
    <style name="CalcColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipChildren">false</item>
    </style>

    <style name="CalcKey.Land" parent="CalcKey">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="CalcKey.Land.Action" parent="CalcKey.Land">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcKey.Land.Ok" parent="CalcKey.Land">
        <item name="backgroundTint">@color/green_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- OK-Taste: auswerten und Ergebnis übernehmen. -->
    <style name="CalcKey.Ok" parent="CalcKey">
        <item name="backgroundTint">@color/green_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
