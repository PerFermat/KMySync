<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Merkmale, die PickerBehaviour an einem Vorschlagsfeld ablegt: der beiseite gelegte Eintrag
         während der Suche und die Regel für unbekannten Text. -->
    <item name="pickerCommitted" type="id" />
    <item name="pickerUnknown" type="id" />
    <item name="pickerAction" type="id" />
    <item name="pickerItem" type="id" />
    <!-- Markiert ein Feld als an eine eigene Rechentastatur gebunden (CalcKeyboardView), damit
         LocalizedActivity die System-Tastatur dafür beim Zurückkehren aus einer Fremd-App erneut
         schließen kann. -->
    <item name="calcKeyboardBound" type="id" />
    <!-- An einer Teilbetrag-Zeile (SplitRowController): die erkannte Anker-Regel dieser Zeile (neben dem
         Standard-Tag, das schon die reine Beschriftung trägt) und ob der Nutzer den Betrag selbst
         eingetippt hat (statt ihn nur vorbelegt zu bekommen). -->
    <item name="splitAnchorRule" type="id" />
    <item name="splitAmountTyped" type="id" />
    <!-- Und die Regel, die für die Kategorie dieser Zeile schon in der Bank-Vorlage steht — über die
         Kategorie gefunden, denn die Beschriftung entsteht erst beim Lernen; leer, wenn es keine gibt.
         Gebraucht für „Nicht lernen": dann bleibt genau sie stehen. -->
    <item name="splitAltRule" type="id" />
    <!-- Der Betrag, für den der Nutzer im Stift-Fenster dieser Zeile entschieden hat. Wie
         SecurityTxEditActivity#entschiedenFuer bei den Hauptfeldern: die Entscheidung hängt am Wert,
         damit die erneut laufende Suche sie nicht stillschweigend überschreibt. -->
    <item name="splitEntschiedenFuer" type="id" />
</resources>
